# ==========================================
# 🌿 Green Web Analyzer - Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Production Build Outputs
client/dist/
client/dist-ssr/
client/build/
dist/
build/
out/
*.local

# Database & Persistent Runtime Data
server/data/*.sqlite
server/data/*.sqlite3
server/data/*.db
*.sqlite
*.sqlite3
*.db
!server/data/.gitkeep

# Runtime Generated Screenshots & Assets
server/public/screenshots/*
!server/public/screenshots/.gitkeep

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Puppeteer Downloads & Chromium
.local-chromium/
.cache/puppeteer/
.cache/

# Testing & Code Coverage
coverage/
.nyc_output/

# IDE & Editor Configs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
